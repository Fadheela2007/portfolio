# Modèle de configuration — copier en backend/.env et renseigner les vraies valeurs.
# Le fichier .env réel ne doit JAMAIS être commité (voir .gitignore).
#
# Le code refuse désormais de démarrer si DB_HOST, DB_USER, DB_PASS, DB_NAME
# ou JWT_SECRET sont absents : il n'y a plus aucune valeur de repli en dur.

PORT=5000

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=NetSecureManager

# Chaîne longue et aléatoire, propre à chaque environnement.
JWT_SECRET=

# Adresse(s) autorisée(s) à appeler l'API depuis un navigateur.
# Plusieurs adresses se séparent par des virgules, sans barre finale.
#
# Laissé vide, seules les adresses locales de développement sont
# acceptées, et un avertissement s'affiche au démarrage. À renseigner
# avant toute mise en service : sans cela, aucune page servie depuis une
# autre adresse ne pourra charger l'interface.
#
# Exemple : FRONTEND_URL=https://supervision.societe.fr,http://192.168.0.10:5173
FRONTEND_URL=

# Temps réel — rafraîchissement de l'interface sans rechargement.
# Laissé vide, la plateforme fonctionne normalement mais l'utilisateur
# doit recharger la page pour voir une nouvelle alerte.
# Mettre l'adresse EXACTE de l'interface, comme pour FRONTEND_URL.
WEBSOCKET_ORIGINE=http://localhost:5173

# Nombre de machines identifiées EN PARALLÈLE pendant un scan.
# Laissé vide : 10. C'est le réglage qui décide de la durée d'un scan —
# nmap représente 93 % du temps, et ce nombre dit combien tournent à la
# fois. Doubler la valeur divise à peu près la durée par deux.
#   10  → discret, convient à un réseau de production en journée
#   16-24 → nettement plus rapide ; à réserver aux réseaux sans sonde
#           d'intrusion, ou aux scans de nuit
# Plafonné à 32.
SCAN_CONCURRENCE=

# Nombre d'adresses pinguées en parallèle pendant le balayage initial.
# Laissé vide : 64. Le ping est bien moins coûteux que l'identification ;
# ce réglage n'a d'effet visible que sur les très grandes plages.
PING_CONCURRENCE=

# Nombre maximal d'adresses qu'une plage de scan a le droit de contenir.
# Laissé vide : 65534, soit un /16. Au-delà, le scan est refusé avec un
# message explicite plutôt que de consommer toute la mémoire du serveur —
# « 10.0.0.0/8 » saisi à la place de « 10.0.0.0/24 » est une faute courante.
SCAN_MAX_HOTES=

# Lecture de CE QUI TOURNE dans chaque machine, pendant le scan.
#
# Le scan lit déjà la MIB HOST-RESOURCES pour le processeur et la mémoire.
# La même MIB expose les programmes en cours (hrSWRun) et les logiciels
# installés (hrSWInstalled) : la plateforme les lit désormais aussi, et les
# affiche dans « Intérieur de la machine » sur la fiche d'équipement.
#
# Rien à installer sur les machines observées. En revanche cela ne marche
# QUE sur celles qui répondent en SNMP — serveurs, imprimantes, équipements
# réseau, machines Linux supervisées. Un poste Windows ordinaire n'active
# pas le service SNMP et n'affichera rien par cette voie ; seul un agent
# installé dessus peut voir son intérieur.
#
# Le coût n'est payé que sur les machines qui ont déjà répondu en SNMP
# pendant l'identification, et les quatre parcours sont faits en parallèle.
# Laissé vide : activé. Mettre 0 pour le désactiver.
SCAN_INVENTAIRE_SNMP=

# ── VOIR CE QUI TOURNE SUR LES POSTES WINDOWS (WMI) ──────────────────
#
# Mesuré sur un parc réel : sur 105 équipements, 7 répondent en SNMP, et
# ce sont sept imprimantes. Les 98 autres sont des postes Windows, qui
# n'activent pas le service SNMP. WMI est leur porte d'entrée — c'est ce
# que les autres plateformes appellent « supervision Windows sans agent ».
#
# RIEN N'EST INSTALLÉ SUR LES POSTES, ET IL N'Y A AUCUN MOT DE PASSE À
# ÉCRIRE. Ce serveur tourne déjà sous un compte Windows — celui de la
# personne qui l'a démarré — et Windows sait s'en servir pour interroger
# un autre poste du domaine. Une seule ligne suffit donc :
#
#     WINDOWS_INVENTAIRE=1
#
# Trois conditions pour que ça fonctionne :
#   1. ce serveur tourne sous Windows (PowerShell est le client utilisé) ;
#   2. la ligne ci-dessus est à 1 ;
#   3. WinRM (port 5985) ou DCOM (port 135) répond sur les postes, et le
#      compte a le droit de les interroger.
#
# Laissée vide, la fonction se tait et le scan se déroule exactement
# comme avant. Aucune erreur, aucun ralentissement.
WINDOWS_INVENTAIRE=

# Les deux lignes suivantes sont FACULTATIVES. Elles ne servent que dans
# deux cas : ce serveur démarre en service Windows sous un compte local
# (qui n'a alors aucun droit sur le domaine), ou vous préférez un compte
# dédié à la supervision plutôt que celui de l'exploitant.
#
# Écrivez le compte sous la forme DOMAINE\utilisateur. Pour connaître
# votre domaine, tapez « whoami » dans PowerShell : il répond exactement
# sous cette forme.
#
#   WINDOWS_UTILISATEUR=MONDOMAINE\svc-supervision
#   WINDOWS_MOT_DE_PASSE=...
#
# CE MOT DE PASSE EST UN SECRET RÉEL : il ouvre les postes du parc. Il
# vit ici et jamais en base, il n'est jamais passé en ligne de commande
# (il transite par l'entrée standard de PowerShell), et backend/.env est
# exclu du dépôt — vérifiez-le avant tout commit.
WINDOWS_UTILISATEUR=
WINDOWS_MOT_DE_PASSE=

# Nombre de postes interrogés EN PARALLÈLE. Ces attentes ne consomment ni
# processeur ni base : elles attendent le réseau, donc les recouvrir est
# gratuit. Laissé vide : 8, ce qui ramène cent postes à environ une
# minute. Plafonné à 24.
WINDOWS_CONCURRENCE=

# Lecture des certificats TLS pendant le scan (expiration, auto-signé,
# protocole accepté). Coût nul sur une machine sans port chiffré ouvert.
# Laissé vide : activé. Mettre 0 pour le désactiver.
SCAN_CERTIFICATS=

# Clé d'API du NVD (National Vulnerability Database), gratuite sur
# nvd.nist.gov. Sans elle : 5 requêtes par fenêtre de 30 secondes lors de
# l'import des failles connues. Avec : 50. N'a d'effet que sur la durée de
# « node tools/importer-failles.js », jamais sur le scan.
NVD_API_KEY=

# ── FRONTEND ──────────────────────────────────────────────────────────
# L'interface se construit avec l'adresse de l'API FIGÉE DEDANS : la
# variable est lue à la compilation, pas à l'exécution. Un « npm run build »
# lancé sans elle produit une interface qui appellera http://localhost:5000
# depuis le poste de chaque utilisateur — c'est-à-dire rien.
#
# À renseigner dans frontend/.env AVANT de compiler :
#   VITE_API_URL=https://supervision.societe.fr/api
# ──────────────────────────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=alertes@example.com

# ── BALAYAGE PAR NMAP ─────────────────────────────────────────────────
# La découverte des machines passe par nmap quand il est installé — il
# est déjà utilisé pour l'empreinte de système. Sur le segment local et
# avec les droits suffisants, nmap interroge en ARP : aucune machine ne
# peut s'y soustraire, et 239 adresses sont balayées en moins de trois
# secondes, là où le ping + cache ARP demande plusieurs minutes et rate
# les postes pare-feutés.
#
# Mettre 0 pour revenir au balayage maison. Vide ou absent : nmap est
# utilisé s'il est disponible, sinon repli automatique et silencieux.
SCAN_BALAYAGE_NMAP=
